# Copia este archivo como .env y cambia los valores. .env no se sube a git.
# En Coolify estas variables se escriben en la pestaña "Environment Variables"
# del recurso; no hace falta subir ningún archivo.

# ── Obligatorias ─────────────────────────────────────────────────────────
# URL de PostgreSQL. En Coolify usa la "Postgres URL (internal)" del recurso
# PostgreSQL (host = uuid del recurso, puerto 5432). Si la contraseña lleva
# símbolos, codifícalos en la URL (por ejemplo @ → %40).
DATABASE_URL=postgres://mercado:cambiaEstaClaveDePostgres123@127.0.0.1:5432/mercado_liebre

# Firma de los tokens de sesión. Mínimo 16 caracteres. Genera una con:
#   openssl rand -hex 32
# Si la cambias, todas las sesiones abiertas se cierran.
APP_SECRET_KEY=cambia-esta-llave-de-al-menos-16

# ── Opcionales ───────────────────────────────────────────────────────────
# Crea esta cuenta de administrador al arrancar si todavía no existe.
# Puedes quitarlas después del primer despliegue.
ADMIN_CORREO=admin@itcj.edu.mx
ADMIN_PASSWORD=cambia-esta-clave-de-admin

# Correo saliente: verificación de cuentas nuevas y reportes de fallas.
# Sin SMTP_USUARIO/SMTP_PASSWORD la API arranca, pero no envía correos.
# Puerto 465 = SSL; 587 = STARTTLS.
SMTP_HOST=smtppro.zoho.com
SMTP_PUERTO=465
SMTP_USUARIO=no.reply@mercadoliebre.shop
SMTP_PASSWORD=cambia-esta-clave-smtp
# Buzón que recibe los reportes. "De:" usa SMTP_USUARIO salvo que definas CORREO_REMITENTE.
CORREO_REPORTES=miguelsoto@mercadoliebre.shop
# Origen de los enlaces de verificación. Vacío: se toma del dominio de la petición.
# URL_PUBLICA=https://mercadoliebre.shop

# Fotos en Garage (almacenamiento S3 de Coolify). Sin estas cuatro variables
# las fotos se guardan en disco (DATOS_PATH/medios). PostgreSQL solo guarda la
# URL /medios/<archivo>; la API lee y escribe los objetos en el bucket.
# Las llaves se crean en Garage (ver docs/DESPLIEGUE.md, 4.1).
# S3_ENDPOINT=https://s3-xxxxxxxx.sslip.io
# S3_BUCKET=mercado-liebre
# S3_ACCESS_KEY=GK...
# S3_SECRET_KEY=cambia-esta-llave-secreta
# S3_REGION=garage

# Origen permitido para llamar a la API desde otro dominio. "*" por defecto.
# CORS_ORIGEN=https://mercado.ejemplo.com
